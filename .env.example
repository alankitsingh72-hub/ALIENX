POSTGRES_PASSWORD=choose-a-local-postgres-password
JWT_SECRET_KEY=replace-with-a-long-random-secret-before-deployment
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NLP_SEMANTIC_ENABLED=false
NLP_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
GRADING_AUTO_ACCEPT_THRESHOLD=0.75
GRADING_REVIEW_THRESHOLD=0.25
NLP_SPACY_ENABLED=false
SPACY_MODEL_NAME=en_core_web_sm
